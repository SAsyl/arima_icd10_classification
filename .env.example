GPT_OSS_HOST=https://hub.qazcode.ai
GPT_OSS_API_KEY="your api key"
GPT_OSS_MODEL=oss-120b
ENABLE_RETRIEVAL=true
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION=ChunkLength-512
USE_RERANKER=true
TOP_K_CHUNKS=50
TOP_N_PROTOCOLS=3
TOP_CHUNKS_PER_PROTOCOL=10
MAX_CHUNK_CHARS=2200
MAX_PROTOCOL_CONTEXT_CHARS=150000
LLM_PARALLELISM=1
GPT_OSS_TIMEOUT_S=60
GPT_OSS_MAX_RETRIES=3
GPT_OSS_RETRY_BACKOFF_S=1.5
